# NINFA daily analysis - the INVOCATION unit for the external scheduler. EXAMPLE: adjust the paths
# and install it as /etc/systemd/system/ninfa-daily-analysis.service.
#
# This repository ships NO timer and does NOT configure a scheduler. Something external must start
# this unit (or run scripts/run-daily-analysis.sh directly) at 10:00 in the NAMED timezone
# Europe/Rome every day. A fixed UTC time is NOT equivalent: it is off by an hour for half of the
# year when daylight saving changes. Whatever scheduler AGRIA picks must support a named timezone,
# or handle the change explicitly. See docs/operations/pilot-daily-operations-v1.md.
#
# Deliberately no [Install] section: nothing enables this unit by itself.
# /opt/ninfa/app is a PLACEHOLDER for the repository checkout. No secrets in this file.
[Unit]
Description=NINFA daily analysis (dispatch, process queue, status)
Documentation=file:///opt/ninfa/app/docs/operations/pilot-daily-operations-v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ninfa
Group=ninfa
WorkingDirectory=/opt/ninfa/app
EnvironmentFile=/etc/ninfa/api.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test ! -e /opt/ninfa/app/.env
ExecStart=/opt/ninfa/app/scripts/run-daily-analysis.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ninfa-daily-analysis
NoNewPrivileges=true
PrivateTmp=true
