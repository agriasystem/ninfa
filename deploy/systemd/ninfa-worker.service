# NINFA worker (Procrastinate on PostgreSQL) - reference unit. EXAMPLE: adjust the paths and install
# it as /etc/systemd/system/ninfa-worker.service.
#
# ONE supervised process, no public port. Concurrency is 1 (one job at a time). Jobs live in
# PostgreSQL: queued jobs survive a restart of this service. A job that is killed while running
# stays in state "doing" (a zombie): nothing recovers it automatically and nothing retries failed
# jobs. See docs/operations/pilot-daily-operations-v1.md.
# /opt/ninfa/app is a PLACEHOLDER for the repository checkout. No secrets in this file.
[Unit]
Description=NINFA worker
Documentation=file:///opt/ninfa/app/docs/operations/pilot-deployment-v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ninfa
Group=ninfa
WorkingDirectory=/opt/ninfa/app
EnvironmentFile=/etc/ninfa/api.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test ! -e /opt/ninfa/app/.env
ExecStart=/opt/ninfa/app/.venv/bin/python -m worker run
Restart=always
RestartSec=5
# On SIGTERM the worker stops taking jobs and WAITS for the running one. If that takes longer than
# TimeoutStopSec, systemd kills it and the job stays "doing". Adjust to the longest expected run.
KillSignal=SIGTERM
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ninfa-worker
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
