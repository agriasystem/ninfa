# NINFA PRODUCTION environment - API, worker and operator CLI (one file, all three).
#
# EXAMPLE ONLY. Copy to /etc/ninfa/api.env on the production host and replace every <PLACEHOLDER>.
# This file holds SECRETS once filled in: owner = the service user, mode 0600
# (chmod 600 /etc/ninfa/api.env). Never commit the filled-in file, never copy it into a ticket or
# a chat, never put it in the web environment.
#
# FORMAT: plain KEY=VALUE lines, values UNQUOTED, comments on their own lines. Both systemd's
# `EnvironmentFile=` and scripts/with-env.sh read it. URL-encode special characters in passwords.
#
# There must be NO `.env` file in the repository checkout on the production host: the application
# would read it as a fallback. All production configuration lives in this file.

# --- Common ---------------------------------------------------------------------------------
# MUST be production: it turns on the startup safety checks (no debug, no wildcard CORS, Secure
# session cookie) and JSON logs. Interactive API docs are disabled in production.
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- API process ----------------------------------------------------------------------------
# The API listens on loopback only; the reverse proxy is the only public entry point.
API_HOST=127.0.0.1
API_PORT=8000
# Single public origin (the reverse proxy serves the web app and /api on the same origin), so no
# cross-origin access is needed: leave EMPTY. Never "*".
CORS_ORIGINS=
# Never set SESSION_COOKIE_SECURE here: the session cookie must stay HTTPS-only. Production
# refuses to start if it is disabled.

# --- Database -------------------------------------------------------------------------------
# A NEW, EMPTY production database (never a copy of the development database). SQLAlchemy URL with
# the psycopg 3 driver, a DIRECT (session-capable) endpoint, TLS required. The role owns the
# database and runs the migrations. See docs/operations/pilot-deployment-v1.md, "Database contract".
DATABASE_URL=postgresql+psycopg://<DB_USER>:<URL_ENCODED_DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<NEW_PRODUCTION_DB_NAME>?sslmode=require

# --- Ask NINFA ------------------------------------------------------------------------------
# unconfigured | anthropic. Keep `unconfigured` until EVERY condition of the Ask NINFA production
# policy is met (docs/operations/pilot-deployment-v1.md): a provider-side hard spending limit, the
# key set here and nowhere else, one real smoke call, token/latency telemetry seen in the logs.
ASK_NINFA_PROVIDER=unconfigured
# Set ONLY together with ASK_NINFA_PROVIDER=anthropic. The key belongs to the API process and to no
# other environment (never the web environment). Uncomment and fill in at enablement time:
# ANTHROPIC_API_KEY=<SET_ONLY_WHEN_ENABLING_ASK_NINFA>

# Deliberately NOT here: TEST_DATABASE_URL (development only; the test suite runs migrations and
# downgrades against it), any development-only override, and any web-only variable.
