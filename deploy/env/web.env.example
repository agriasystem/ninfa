# NINFA PRODUCTION environment - WEB (Next.js) only.
#
# EXAMPLE ONLY. Copy to /etc/ninfa/web.env on the production host. This file contains NO secrets
# and must stay that way: the web process needs only the three values below. It must never receive
# database credentials or any API key (those live only in /etc/ninfa/api.env).
#
# FORMAT: plain KEY=VALUE lines, values UNQUOTED, comments on their own lines.
#
# IMPORTANT - BUILD-TIME VALUE: NEXT_PUBLIC_API_BASE_URL is compiled INTO the web bundle when the
# app is built. Changing the public origin means REBUILDING the web app
# (scripts/with-env.sh /etc/ninfa/web.env npm run build -w @ninfa/web) and restarting it; editing
# this file alone changes nothing for an already-built app.

# The ABSOLUTE public origin: scheme + host, no trailing slash, no /api/v1. The browser calls
# {origin}/api/v1/... and the reverse proxy forwards /api/ to the API. EXAMPLE value - replace it.
NEXT_PUBLIC_API_BASE_URL=https://ninfa.example.com

# Next.js listens on loopback only; the reverse proxy is the only public entry point.
WEB_HOST=127.0.0.1
WEB_PORT=3100
