# NINFA — environment template.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.
# `.env` is read from the repository root by api, worker and web.

# --- Common -----------------------------------------------------------------
# development | test | production
APP_ENV=development
# Verbose errors / auto-reload. Must be false in production (enforced by the API).
DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- API (services/api) -----------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins (must include the web origin).
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL, psycopg 3 driver. Use a dedicated non-superuser application role.
DATABASE_URL=postgresql+psycopg://ninfa_app:CHANGE_ME@127.0.0.1:5432/ninfa_dev
# Database used by the backend test-suite. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://ninfa_app:CHANGE_ME@127.0.0.1:5432/ninfa_test

# --- Ask NINFA (services/api, Gate 18/19) ------------------------------------
# unconfigured | anthropic. Defaults to unconfigured: Ask NINFA answers UNAVAILABLE until a
# provider is explicitly selected here - an API key alone is never enough.
ASK_NINFA_PROVIDER=unconfigured
# Required only when ASK_NINFA_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# --- Smart Import semantic layer (services/api, OpenAI Responses API) ---------
# off | shadow | assist. `off` (the default) never asks a model anything and never loads the SDK.
# `shadow` asks the model and MEASURES it against NINFA's own reading: nothing it says is applied.
# `assist` applies its reading as suggestions - after every NINFA check, never instead of one.
# A mode other than `off` with no key is not an error: Smart Import runs exactly as with `off`.
# `SMART_IMPORT_AI_MODE` (shadow/assist) and `IMPORT_UNDERSTANDING_PROVIDER` (the original Anthropic
# assistant) both select a model for Smart Import: setting a mode other than `off` AND a provider
# other than `unconfigured` is a STARTUP ERROR, never a silent precedence. Set only one of them.
SMART_IMPORT_AI_MODE=off
# Never commit a real key. A key alone is never enough: the mode above decides.
OPENAI_API_KEY=
SMART_IMPORT_OPENAI_MODEL=gpt-6.1-sol
# none | minimal | low | medium | high (`none` sends no reasoning parameter). The default model
# (gpt-6.1-sol) accepts low / medium / high (and xhigh, max) - NOT none or minimal. `low` reads as
# well as `medium` in about 60% of the time (measured, V1.1).
SMART_IMPORT_OPENAI_REASONING=low
# false (the default): whatever the model names stays a MEDIUM suggestion a person confirms.
# true: a column the model named whose values NINFA's own vocabulary recognises becomes certain.
# It is off because the live benchmark found three unsafe READY with it on (ADR 0052).
SMART_IMPORT_AI_VOCABULARY_CERTAINTY=false
# Optional: a custom https endpoint OR a regional one the OpenAI project is set up for (eu, us, ...).
# Never both. Nothing is hard-coded: leave both unset for the default endpoint.
# OPENAI_BASE_URL=
# OPENAI_DATA_RESIDENCY=

# --- Web (apps/web) ---------------------------------------------------------
# Port of the Next.js server (3000 is left free on purpose).
WEB_PORT=3100
# Interface the Next.js server binds to (loopback only by default).
WEB_HOST=127.0.0.1
# Base URL of the API as seen by the browser (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Docker Compose (optional, portable Postgres; see docker-compose.yml) ---
POSTGRES_HOST_PORT=5433
# Container superuser password (bootstrap only).
POSTGRES_PASSWORD=CHANGE_ME
# Password of the `ninfa_app` role created in the container; keep equal to DATABASE_URL's.
NINFA_APP_PASSWORD=CHANGE_ME
