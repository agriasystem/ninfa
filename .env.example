# NINFA — environment template.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.
# `.env` is read from the repository root by api, worker and web.

# --- Common -----------------------------------------------------------------
# development | test | production
APP_ENV=development
# Verbose errors / auto-reload. Must be false in production (enforced by the API).
DEBUG=false
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- API (services/api) -----------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins (must include the web origin).
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL, psycopg 3 driver. Use a dedicated non-superuser application role.
DATABASE_URL=postgresql+psycopg://ninfa_app:CHANGE_ME@127.0.0.1:5432/ninfa_dev
# Database used by the backend test-suite. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://ninfa_app:CHANGE_ME@127.0.0.1:5432/ninfa_test

# --- Web (apps/web) ---------------------------------------------------------
# Port of the Next.js server (3000 is left free on purpose).
WEB_PORT=3100
# Interface the Next.js server binds to (loopback only by default).
WEB_HOST=127.0.0.1
# Base URL of the API as seen by the browser (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Docker Compose (optional, portable Postgres; see docker-compose.yml) ---
POSTGRES_HOST_PORT=5433
# Container superuser password (bootstrap only).
POSTGRES_PASSWORD=CHANGE_ME
# Password of the `ninfa_app` role created in the container; keep equal to DATABASE_URL's.
NINFA_APP_PASSWORD=CHANGE_ME
